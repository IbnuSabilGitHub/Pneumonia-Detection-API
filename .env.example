# ========================================
# APPLICATION CONFIGURATION
# ========================================

# Application Info
APP_NAME=Pneumonia Detection API
APP_VERSION=3.6.0
DEBUG=false

# Server Configuration
HOST=0.0.0.0
PORT=8000

# ========================================
# SECURITY & AUTHENTICATION
# ========================================

# JWT Authentication (Supabase) - ES256
# Master toggle - set to true to enable JWT authentication
JWT_AUTH_ENABLED=true

# Supabase Project URL (REQUIRED if JWT_AUTH_ENABLED=true)
# Used to fetch JWKS (public keys) for ES256 token verification
# Get from: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon/Public Key (optional, for client-side reference/setup)
# Get from: Supabase Dashboard → Settings → API → API Keys → anon
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Verify JWT audience claim (default: true)
SUPABASE_JWT_VERIFY_AUDIENCE=true

# Admin API Security
# Admin endpoints (/security/status, /security/stats) support TWO authentication methods:
# 1. Supabase JWT with admin role (app_metadata.role = "admin")
# 2. Legacy API Key (X-Admin-API-Key header) - for backward compatibility
#
# Generate API key with: openssl rand -hex 32
# or: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=your-secure-random-key-here

# Public access to admin endpoints (NOT RECOMMENDED for production)
ENABLE_PUBLIC_STATS=false
ENABLE_PUBLIC_STATUS=false

# ========================================
# CORS & TRUSTED HOSTS
# ========================================

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=*
ALLOWED_ORIGINS=http://localhost:3000

# Trusted hosts (comma-separated)
TRUSTED_HOSTS=localhost,127.0.0.1,0.0.0.0,*.onrender.com

# ========================================
# FILE UPLOAD & MODEL CONFIGURATION
# ========================================

# File Upload Settings
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=.jpg,.jpeg,.png

# Model Paths
MODEL_PATH=models/pneumonia_model_standard.onnx
MODEL_STATS_PATH=models/model_stats_standard.json
MODEL_PATH_EFFICIENTNET_B0=models/pneumonia_model_efficientnet_b0.onnx
MODEL_STATS_PATH_EFFICIENTNET_B0=models/model_stats_efficientnet_b0.json

# ========================================
# STORAGE BACKEND CONFIGURATION
# ========================================

# Storage Backend (memory, database)
STORAGE_BACKEND=memory

# In-Memory Storage Configuration (free tier optimized)
MEMORY_MAX_SIZE=1000
MEMORY_CLEANUP_INTERVAL=180
MEMORY_DEFAULT_TTL=1800

# ========================================
# RATE LIMITING CONFIGURATION
# ========================================

# Advanced Rate Limiting - Master Toggle
ADVANCED_RATE_LIMITING_ENABLED=true

# Excluded paths (comma-separated)
EXCLUDED_PATHS=/health,/,/docs,/redoc,/openapi.json

# Basic Rate Limiting - Production Settings
MAX_REQUESTS_PER_IP=100
MAX_FINGERPRINT_REQUESTS=50
RATE_LIMIT_WINDOW_SIZE=300

# Prediction-Specific Rate Limiting
PREDICTION_CONCURRENCY_LIMIT=3
PREDICTION_MAX_REQUESTS_PER_IP=18
PREDICTION_RATE_WINDOW=300

# Attack Detection Thresholds
IP_SWITCHING_THRESHOLD=5
SUSPICIOUS_IP_CHANGES_THRESHOLD=10
GLOBAL_ATTACK_THRESHOLD=0.7
BOT_BEHAVIOR_VARIANCE=0.1
COORDINATED_ATTACK_THRESHOLD=3
BOT_TIMING_THRESHOLD=2.0

# Block Durations (seconds)
ATTACK_BLOCK_DURATION=300
FINGERPRINT_BLOCK_DURATION=600

# Attack Detection Windows (seconds)
IP_SWITCHING_DETECTION_WINDOW=300
BEHAVIORAL_ANALYSIS_WINDOW=600
GLOBAL_ATTACK_SCORE_WINDOW=900

# In-Memory Limits (optimized for free tier)
MAX_RECENT_IPS=1000
MAX_REQUEST_PATTERNS_PER_IP=50
MAX_FILE_HASH_REQUESTS=500
MAX_GLOBAL_REQUEST_RATE=500
MAX_FINGERPRINTS_PER_IP=10

# Attack Response
ATTACK_REDUCTION_FACTOR=0.5

# ========================================
# CACHING CONFIGURATION
# ========================================

CACHE_DURATION=300
FILE_HASH_CACHE_MAX_SIZE=200

# ========================================
# LOGGING CONFIGURATION
# ========================================

LOG_LEVEL=INFO
LOG_ENABLED=true
LOG_UNIFY_UVICORN=false
LOG_INCLUDE_TIMESTAMP=true
LOG_INCLUDE_LEVEL=true
LOG_INCLUDE_LOGGER_NAME=true
LOG_INCLUDE_MODULE=false
LOG_INCLUDE_PROCESS=false
LOG_INCLUDE_THREAD=false
LOG_INCLUDE_FILENAME=false
LOG_INCLUDE_LINE_NUMBER=false
LOG_FIELD_SEPARATOR= - 

# Custom log formats (leave empty to use dynamic builder)
LOG_FORMAT=
LOG_FORMAT_WITH_TIMESTAMP=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_FORMAT_WITHOUT_TIMESTAMP=%(name)s - %(levelname)s - %(message)s

# ========================================
# DEPLOYMENT ENVIRONMENT
# ========================================

# Railway specific
RAILWAY_ENVIRONMENT=
