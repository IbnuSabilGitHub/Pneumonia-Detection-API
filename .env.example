# Pneumonia Detection API Configuration
# Copy this file to .env and modify as needed

# Application Settings
APP_NAME="Pneumonia Detection API"
APP_VERSION="3.1.0"
DEBUG=false

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Security Settings
TRUSTED_HOSTS="*.railway.app,localhost,127.0.0.1"
CORS_ORIGINS="*"

# File Upload Limits
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_EXTENSIONS=".jpg,.jpeg,.png"

# Model Configuration
MODEL_PATH="models/pneumonia_model.onnx"
MODEL_STATS_PATH="models/model_stats.json"

# Advanced Rate Limiting - Production Settings for Free Tier
ADVANCED_RATE_LIMITING_ENABLED=true
MAX_REQUESTS_PER_IP=100
MAX_FINGERPRINT_REQUESTS=50
RATE_LIMIT_WINDOW_SIZE=300  # 5 minutes
IP_SWITCHING_THRESHOLD=5
SUSPICIOUS_IP_CHANGES_THRESHOLD=10
GLOBAL_ATTACK_THRESHOLD=0.7
BOT_BEHAVIOR_VARIANCE=0.1
ATTACK_BLOCK_DURATION=300  # 5 minutes
FINGERPRINT_BLOCK_DURATION=600  # 10 minutes
IP_SWITCHING_DETECTION_WINDOW=300
BEHAVIORAL_ANALYSIS_WINDOW=600
GLOBAL_ATTACK_SCORE_WINDOW=900
COORDINATED_ATTACK_THRESHOLD=3
BOT_TIMING_THRESHOLD=2.0
MAX_RECENT_IPS=1000
MAX_REQUEST_PATTERNS_PER_IP=50
MAX_FILE_HASH_REQUESTS=500
MAX_GLOBAL_REQUEST_RATE=500
MAX_FINGERPRINTS_PER_IP=10
ATTACK_REDUCTION_FACTOR=0.5

# Storage Backend Configuration
STORAGE_BACKEND=memory
MEMORY_MAX_SIZE=1000
MEMORY_CLEANUP_INTERVAL=180
MEMORY_DEFAULT_TTL=1800

# Caching
CACHE_DURATION=300  # 5 minutes

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"

# Optional: Redis URL for production rate limiting
# REDIS_URL="redis://localhost:6379/0"

# Railway Configuration (for deployment)
RAILWAY_ENVIRONMENT=production

# Legacy settings (backward compatibility)
ALLOWED_ORIGINS="http://localhost:3000,https://your-frontend-domain.vercel.app"
